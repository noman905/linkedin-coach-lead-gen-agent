# Apify API Token (from https://console.apify.com -> Settings -> Integrations)
APIFY_API_TOKEN=your_apify_api_token_here

# Google Service Account Credentials
# (Paste the entire JSON contents of your service account key file, or provide the path to credentials.json)
GOOGLE_SHEETS_CREDENTIALS=paste_entire_json_content_here

# Google Spreadsheet ID (from the Google Sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=your_spreadsheet_id_here

# Optional: Sheet Tab Names (defaults to Control and Leads)
CONTROL_TAB_NAME=Control
LEADS_TAB_NAME=Leads
